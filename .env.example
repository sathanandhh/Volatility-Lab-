# ── Volatility MCP — Environment Configuration ─────────────────────
# Copy to .env and adjust as needed.

# ── Data Providers ──────────────────────────────────────────────────
# Default provider for market data (yfinance | csv | alpha_vantage | polygon | kite)
VOLMCP_DEFAULT_PROVIDER=yfinance

# Alpha Vantage (free tier: https://www.alphavantage.co/support/#api-key)
VOLMCP_ALPHA_VANTAGE_API_KEY=

# Polygon.io (https://polygon.io/)
VOLMCP_POLYGON_API_KEY=

# Zerodha Kite (Indian markets — https://kite.trade/)
VOLMCP_KITE_API_KEY=
VOLMCP_KITE_ACCESS_TOKEN=

# ── Cache TTLs (seconds) ───────────────────────────────────────────
VOLMCP_PRICE_CACHE_TTL=3600
VOLMCP_FIT_CACHE_TTL=3600

# ── Model Fitting ───────────────────────────────────────────────────
VOLMCP_DEFAULT_DISTRIBUTION=t
VOLMCP_DEFAULT_MAXITER=1000

# ── Reporting ──────────────────────────────────────────────────────
VOLMCP_REPORT_DIR=/tmp/volmcp_reports

# ── Session Storage ─────────────────────────────────────────────────
# Backend: memory (default, in-process) | sqlite | duckdb
VOLMCP_SESSION_BACKEND=memory
VOLMCP_SESSION_DB=/tmp/volmcp_sessions.db

# ── MCP Transport (for SSE / streamable-http) ───────────────────────
# Set these when running with --transport sse
VOLMCP_MCP_HOST=0.0.0.0
VOLMCP_MCP_PORT=8765
