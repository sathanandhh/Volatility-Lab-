{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "volatility-mcp/schemas/backtest_result.json",
  "title": "Backtest Result",
  "description": "Output schema for backtest.rolling_backtest and the coverage suite.",
  "type": "object",
  "required": ["models", "test_window", "per_model", "next_actions"],
  "properties": {
    "models":       {"type": "array", "items": {"type": "string"}},
    "test_window":   {"type": "integer"},
    "refit_every":   {"type": "integer"},
    "alpha":         {"type": "number"},
    "per_model": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "breaches":                  {"type": "integer"},
          "breach_rate_pct":           {"type": "number"},
          "expected_breach_rate_pct":  {"type": "number"}
        }
      }
    },
    "coverage": {
      "type": "object",
      "description": "Populated when backtest_coverage_scorecard is run.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kupiec_p":                {"type": "number"},
          "independence_p":          {"type": "number"},
          "conditional_coverage_p":  {"type": "number"},
          "traffic_light_zone":      {"type": "string"},
          "dynamic_quantile_p":      {"type": "number"},
          "verdict":                 {"type": "string", "enum": ["pass", "review"]}
        }
      }
    },
    "next_actions": {"type": "array", "items": {"type": "string"}}
  }
}
