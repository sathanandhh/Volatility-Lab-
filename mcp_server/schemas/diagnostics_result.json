{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "volatility-mcp/schemas/diagnostics_result.json",
  "title": "Diagnostics Result",
  "description": "Output schema for diagnostics.run — full residual diagnostic suite on a fitted model.",
  "type": "object",
  "required": ["model", "ljung_box_resid_lag10", "arch_lm_lag10", "normality", "accuracy", "information_criteria", "recommendations", "next_actions"],
  "properties": {
    "model": {"type": "string"},
    "ljung_box_resid_lag10":  {"$ref": "#/$defs/testResult"},
    "ljung_box_resid_lag20":  {"$ref": "#/$defs/testResult"},
    "ljung_box_sq_resid_lag10": {"$ref": "#/$defs/testResult"},
    "arch_lm_lag10":          {"$ref": "#/$defs/testResult"},
    "normality": {
      "type": "object",
      "properties": {
        "jarque_bera":        {"$ref": "#/$defs/testResult"},
        "shapiro_wilk":       {"$ref": "#/$defs/testResult"},
        "anderson_darling":   {"$ref": "#/$defs/testResult"}
      }
    },
    "sign_bias": {"type": "object"},
    "nyblom_stability": {"type": "object"},
    "accuracy": {
      "type": "object",
      "properties": {
        "qlike":    {"type": "number"},
        "vol_rmse": {"type": "number"},
        "mae":      {"type": "number"}
      }
    },
    "information_criteria": {
      "type": "object",
      "properties": {
        "aic":  {"type": "number"},
        "bic":  {"type": "number"},
        "hqic": {"type": "number"}
      }
    },
    "recommendations": {"type": "array", "items": {"type": "string"}},
    "next_actions":    {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "testResult": {
      "type": "object",
      "required": ["statistic", "p_value"],
      "properties": {
        "statistic": {"type": "number"},
        "p_value":   {"type": "number"}
      }
    }
  }
}
