{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "volatility-mcp/schemas/fit_result.json",
  "title": "Model Fit Result",
  "description": "Output schema for models.fit — parameter estimates, convergence, and conditional volatility tail.",
  "type": "object",
  "required": ["model", "converged", "aic", "bic", "next_actions"],
  "properties": {
    "model":       {"type": "string"},
    "converged":   {"type": "boolean"},
    "n_params":    {"type": "integer"},
    "log_likelihood": {"type": "number"},
    "aic":         {"type": "number"},
    "bic":         {"type": "number"},
    "params": {
      "type": "object",
      "description": "Parameter name → estimate",
      "additionalProperties": {"type": "number"}
    },
    "conditional_volatility_tail": {
      "type": "array",
      "description": "Last 5 conditional volatility observations.",
      "items": {
        "type": "object",
        "properties": {
          "date": {"type": "string"},
          "vol":  {"type": "number"}
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["fitted", "blocked"],
      "description": "If 'blocked', blocked_checks is populated."
    },
    "blocked_checks": {
      "type": "array",
      "items": {"type": "string"}
    },
    "next_actions": {"type": "array", "items": {"type": "string"}}
  }
}
